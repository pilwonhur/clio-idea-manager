#!/usr/bin/env python3
"""idea_export — 내보내기 계층 (PRD §10, §9.3).

SQLite가 원본이고 Markdown·JSON은 열람·백업용 출력이다 (PRD §2).
렌더링은 clio_ops에 있다. 백업도 같은 코드로 스냅샷을 내보낸다.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clio_core import connect, data_dir, run_cli  # noqa: E402
from clio_ops import export_json, export_md  # noqa: E402


def cmd_json(args, cfg):
    conn = connect(create=False)
    out = Path(args.out).expanduser() if args.out else data_dir() / "exports" / "clio-export.json"
    return export_json(conn, cfg, out, args.include_deleted)


def cmd_md(args, cfg):
    conn = connect(create=False)
    out = Path(args.out).expanduser() if args.out else data_dir() / "exports" / "markdown"
    return export_md(conn, cfg, out, args.include_deleted)


def build_parser():
    p = argparse.ArgumentParser(prog="idea_export", description="Clio 내보내기")
    sub = p.add_subparsers(dest="cmd")
    j = sub.add_parser("json", help="JSON 전량 내보내기")
    j.add_argument("--out")
    j.add_argument("--include-deleted", action="store_true")
    j.set_defaults(fn=cmd_json)
    m = sub.add_parser("md", help="Markdown 내보내기 (Obsidian 열람용)")
    m.add_argument("--out")
    m.add_argument("--include-deleted", action="store_true")
    m.set_defaults(fn=cmd_md)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
