#!/usr/bin/env python3
"""idea_check — 운영 안정성 계층 (PRD §9.3, §9.4, §10)."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import subprocess
import sys
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clio_core import (  # noqa: E402
    ClioError, connect, data_dir, now_iso, run_cli, sha256_file, sha256_text,
)

COUNT_TABLES = ["idea", "raw_entry", "revision", "idea_relation", "tag", "idea_tag",
                "source", "attachment", "action_log"]


def _open(path) -> sqlite3.Connection:
    """검사·대조용 읽기 연결. run_integrity는 Row 팩토리를 전제한다."""
    conn = sqlite3.connect(path)
    conn.row_factory = sqlite3.Row
    return conn


# --------------------------------------------------------------------------
# 무결성 검사 (PRD §9.4)
# --------------------------------------------------------------------------

def run_integrity(conn) -> dict:
    problems = []

    def add(kind, detail):
        problems.append({"check": kind, "detail": detail})

    # 1. 원문 해시 일치
    for r in conn.execute("SELECT id, body, body_hash FROM raw_entry WHERE redacted_at IS NULL"):
        if sha256_text(r["body"]) != r["body_hash"]:
            add("raw_body_hash", f"entry {r['id']}의 본문 해시가 일치하지 않습니다")

    # 2. latest_revision_id가 최대 rev_no를 가리키는가
    for r in conn.execute(
        "SELECT i.id, i.ref, i.latest_revision_id, "
        "(SELECT id FROM revision WHERE idea_id=i.id ORDER BY rev_no DESC LIMIT 1) AS top "
        "FROM idea i WHERE i.deleted_at IS NULL"):
        if r["top"] is not None and r["latest_revision_id"] != r["top"]:
            add("latest_revision", f"{r['ref']}의 latest_revision_id가 최신 revision과 다릅니다")
        if r["top"] is None and r["latest_revision_id"] is not None:
            add("latest_revision", f"{r['ref']}가 존재하지 않는 revision을 가리킵니다")

    # 3. 고아 레코드
    orphan_sql = {
        "revision": "SELECT COUNT(*) c FROM revision r LEFT JOIN idea i ON i.id=r.idea_id WHERE i.id IS NULL",
        "idea_relation_from": "SELECT COUNT(*) c FROM idea_relation r LEFT JOIN idea i ON i.id=r.from_idea_id WHERE i.id IS NULL",
        "idea_relation_to": "SELECT COUNT(*) c FROM idea_relation r LEFT JOIN idea i ON i.id=r.to_idea_id WHERE i.id IS NULL",
        "idea_tag": "SELECT COUNT(*) c FROM idea_tag it LEFT JOIN idea i ON i.id=it.idea_id WHERE i.id IS NULL",
        "raw_entry": "SELECT COUNT(*) c FROM raw_entry e WHERE e.idea_id IS NOT NULL "
                     "AND NOT EXISTS (SELECT 1 FROM idea i WHERE i.id=e.idea_id)",
        "attachment": "SELECT COUNT(*) c FROM attachment a LEFT JOIN raw_entry e ON e.id=a.raw_entry_id WHERE e.id IS NULL",
    }
    for name, sql in orphan_sql.items():
        n = conn.execute(sql).fetchone()["c"]
        if n:
            add("orphan", f"{name}에 고아 레코드 {n}건")

    # 4. ref 중복·누락
    refs = [r["ref"] for r in conn.execute("SELECT ref FROM idea")]
    if len(refs) != len(set(refs)):
        add("ref_duplicate", "글감 번호가 중복되었습니다")
    nums = sorted(int(x.rsplit("-", 1)[1]) for x in refs if "-" in x)
    if nums:
        missing = sorted(set(range(1, nums[-1] + 1)) - set(nums))
        if missing:
            add("ref_gap", f"번호 공백 {len(missing)}건 (tombstone 삭제 시 정상): {missing[:10]}")

    # 5. 미분류 원문
    unassigned = conn.execute(
        "SELECT COUNT(*) c FROM raw_entry WHERE assign_state='unassigned' "
        "AND redacted_at IS NULL").fetchone()["c"]

    # 6. 대칭 관계 정규화
    for r in conn.execute(
        "SELECT id, from_idea_id, to_idea_id FROM idea_relation "
        "WHERE symmetric=1 AND from_idea_id > to_idea_id"):
        add("symmetry", f"relation {r['id']}의 대칭 관계 정규화가 깨졌습니다")

    # 7. 첨부 파일 해시·존재
    for r in conn.execute("SELECT * FROM attachment WHERE redacted_at IS NULL"):
        p = data_dir() / r["stored_path"]
        if not p.exists():
            add("attachment_missing", f"첨부 파일 없음: {r['stored_path']}")
        elif sha256_file(p) != r["sha256"]:
            add("attachment_hash", f"첨부 해시 불일치: {r['stored_path']}")

    pragma = conn.execute("PRAGMA integrity_check").fetchone()[0]
    if pragma != "ok":
        add("sqlite", pragma)

    counts = {t: conn.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"] for t in COUNT_TABLES}
    return {"healthy": not problems, "problem_count": len(problems), "problems": problems,
            "unassigned_entries": unassigned, "counts": counts}


def cmd_init(args, cfg):
    """데이터베이스와 디렉터리를 만든다. 이미 있으면 그대로 둔다 (멱등)."""
    existed = (data_dir() / "ideas.db").exists()
    conn = connect(create=True)
    for sub in ("attachments", "exports", "backups"):
        (data_dir() / sub).mkdir(parents=True, exist_ok=True)
    version = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
    counts = {t: conn.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"]
              for t in COUNT_TABLES}
    return {"data_dir": str(data_dir()), "created": not existed,
            "schema_version": version["value"] if version else None, "counts": counts,
            "message": ("데이터베이스를 새로 만들었습니다." if not existed
                        else "기존 데이터베이스를 그대로 사용합니다.")}


def cmd_integrity(args, cfg):
    conn = connect(create=False)
    result = run_integrity(conn)
    if not result["healthy"] and args.strict:
        raise ClioError("integrity_failed", f"무결성 문제 {result['problem_count']}건",
                        problems=result["problems"])
    return result


# --------------------------------------------------------------------------
# 백업 (PRD §9.3)
# --------------------------------------------------------------------------

def _snapshot(src_conn, dest: Path):
    """실행 중인 DB 파일을 복사하지 않고 sqlite3 백업 API로 스냅샷을 뜬다."""
    dest.parent.mkdir(parents=True, exist_ok=True)
    target = sqlite3.connect(dest)
    try:
        src_conn.backup(target)
    finally:
        target.close()


def _copy_tree(src: Path, dst: Path):
    if not src.exists():
        return 0
    n = 0
    for p in src.rglob("*"):
        if p.is_file():
            rel = p.relative_to(src)
            out = dst / rel
            out.parent.mkdir(parents=True, exist_ok=True)
            try:
                os.link(p, out)
            except OSError:
                shutil.copy2(p, out)
            n += 1
    return n


def _prune(backup_root: Path, cfg):
    """일 7 / 주 4 / 월 12 rolling 보존."""
    dirs = sorted([d for d in backup_root.iterdir() if d.is_dir() and d.name[0].isdigit()],
                  reverse=True)
    keep, seen_w, seen_m = set(), set(), set()
    ret = cfg["backup_retention"]
    for i, d in enumerate(dirs):
        try:
            when = datetime.strptime(d.name[:15], "%Y%m%dT%H%M%S")
        except ValueError:
            keep.add(d)
            continue
        if i < ret["daily"]:
            keep.add(d)
        wk = when.strftime("%G-W%V")
        if wk not in seen_w and len(seen_w) < ret["weekly"]:
            seen_w.add(wk); keep.add(d)
        mo = when.strftime("%Y-%m")
        if mo not in seen_m and len(seen_m) < ret["monthly"]:
            seen_m.add(mo); keep.add(d)
    removed = []
    for d in dirs:
        if d not in keep:
            shutil.rmtree(d, ignore_errors=True)
            removed.append(d.name)
    return removed


def _redaction_manifest(conn, backup_root: Path, ts: str):
    """영구 삭제 사실을 백업과 함께 보존한다 (PRD §9.2).

    기존 백업 파일은 소급 수정하지 않는다. 복구 시 이 목록을 재적용한다.
    """
    path = backup_root / "redaction_manifest.json"
    items = []
    for r in conn.execute("SELECT id, redacted_at, body_hash FROM raw_entry "
                          "WHERE redacted_at IS NOT NULL"):
        items.append({"kind": "raw_entry", "entry_id": r["id"],
                      "redacted_at": r["redacted_at"], "body_hash": r["body_hash"]})
    for r in conn.execute("SELECT ref, deleted_at FROM idea WHERE deleted_at IS NOT NULL"):
        items.append({"kind": "idea", "ref": r["ref"], "deleted_at": r["deleted_at"]})
    path.write_text(json.dumps({"updated_at": ts, "entries": items},
                               ensure_ascii=False, indent=2), encoding="utf-8")
    return len(items)


def cmd_backup(args, cfg):
    conn = connect(create=False)
    ts = now_iso(cfg)
    stamp = datetime.fromisoformat(ts).strftime("%Y%m%dT%H%M%S")
    root = Path(args.out).expanduser() if args.out else data_dir() / "backups"
    dest = root / stamp
    dest.mkdir(parents=True, exist_ok=True)

    _snapshot(conn, dest / "ideas.db")
    here = Path(__file__).resolve().parent
    env = dict(os.environ, CLIO_DATA_DIR=str(data_dir()))
    subprocess.run([sys.executable, str(here / "idea_export"), "json",
                    "--out", str(dest / "clio-export.json")], check=True,
                   capture_output=True, env=env)
    subprocess.run([sys.executable, str(here / "idea_export"), "md",
                    "--out", str(dest / "markdown")], check=True,
                   capture_output=True, env=env)
    n_att = _copy_tree(data_dir() / "attachments", dest / "attachments")
    n_red = _redaction_manifest(conn, root, ts)

    snap = _open(dest / "ideas.db")
    verify = run_integrity(snap)
    counts = {t: snap.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"]
              for t in COUNT_TABLES}
    snap.close()
    (dest / "manifest.json").write_text(json.dumps(
        {"created_at": ts, "counts": counts, "attachments": n_att,
         "db_sha256": sha256_file(dest / "ideas.db")},
        ensure_ascii=False, indent=2), encoding="utf-8")

    removed = _prune(root, cfg)
    mirrored = None
    if not args.no_mirror and cfg.get("backup_mirror"):
        mpath = Path(cfg["backup_mirror"]).expanduser() / stamp
        if mpath.parent.parent.exists():
            mpath.mkdir(parents=True, exist_ok=True)
            _copy_tree(dest, mpath)
            shutil.copy2(root / "redaction_manifest.json",
                         mpath.parent / "redaction_manifest.json")
            mirrored = str(mpath)
    return {"path": str(dest), "counts": counts, "attachments": n_att,
            "redaction_entries": n_red, "pruned": removed, "mirrored_to": mirrored,
            "verified": verify["healthy"]}


def cmd_restore_test(args, cfg):
    """백업으로 새 DB를 복구한 뒤 건수를 대조한다 (TC7)."""
    src = Path(args.source).expanduser()
    db = src / "ideas.db" if src.is_dir() else src
    if not db.exists():
        raise ClioError("backup_missing", f"백업 데이터베이스가 없습니다: {db}")
    live = connect(create=False)
    live_counts = {t: live.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"]
                   for t in COUNT_TABLES}
    restored = _open(":memory:")
    src_conn = sqlite3.connect(db)
    src_conn.backup(restored)
    src_conn.close()
    r_counts = {t: restored.execute(f"SELECT COUNT(*) c FROM {t}").fetchone()["c"]
                for t in COUNT_TABLES}
    integ = run_integrity(restored)
    diff = {t: {"live": live_counts[t], "restored": r_counts[t]}
            for t in COUNT_TABLES if live_counts[t] != r_counts[t]}
    return {"source": str(db), "match": not diff, "diff": diff,
            "restored_counts": r_counts, "restored_healthy": integ["healthy"],
            "note": "차이는 백업 이후 추가된 기록일 수 있습니다."}


# --------------------------------------------------------------------------
# reconcile / calibrate
# --------------------------------------------------------------------------

def cmd_reconcile(args, cfg):
    """DB 쪽에서 확인 가능한 사실만 보고한다.

    브리지가 제3자 도구이므로 채널 원본 이력을 이 도구가 직접 읽을 수 없다.
    따라서 '지시어를 보냈는데 저장되지 않은 메시지'는 여기서 알 수 없다.
    교수님이 Discord 이력과 대조할 수 있도록 DB가 아는 범위를 그대로 낸다.
    """
    conn = connect(create=False)
    since = args.since or "0000-00-00"
    rows = list(conn.execute(
        "SELECT e.id, e.captured_at, e.assign_state, s.message_id, i.ref "
        "FROM raw_entry e LEFT JOIN source s ON s.id=e.source_id "
        "LEFT JOIN idea i ON i.id=e.idea_id "
        "WHERE substr(e.captured_at,1,10) >= ? ORDER BY e.captured_at", (since,)))
    no_msg_id = sum(1 for r in rows if not r["message_id"])
    return {
        "since": since, "captured": len(rows),
        "unassigned": sum(1 for r in rows if r["assign_state"] == "unassigned"),
        "without_message_id": no_msg_id,
        "entries": [{"entry_id": r["id"], "captured_at": r["captured_at"],
                     "message_id": r["message_id"], "ref": r["ref"]} for r in rows],
        "limitation": "브리지가 제3자 도구이므로 채널 원본 이력은 이 도구가 읽을 수 없습니다. "
                      "위 목록을 Discord 채널의 '글감:' 메시지와 직접 대조하세요.",
    }


def cmd_calibrate(args, cfg):
    """D1 임계값 조정 근거 산출 (PRD §14.1).

    similar이 남긴 후보 제시 이력과, 그 뒤 실제로 어떤 글감에 배정됐는지를 대조한다.
    """
    conn = connect(create=False)
    cands = [json.loads(r["payload"]) for r in conn.execute(
        "SELECT payload FROM action_log WHERE action='candidates' ORDER BY id")]
    outcome = {}
    for r in conn.execute(
        "SELECT action, payload FROM action_log WHERE action IN ('assign','new_idea') "
        "AND undone_at IS NULL ORDER BY id"):
        p = json.loads(r["payload"])
        if p.get("entry_id"):
            outcome[p["entry_id"]] = (r["action"], p.get("idea_ref") or p.get("ref"))

    buckets, samples = {}, 0
    for c in cands:
        eid = c.get("entry_id")
        if not eid or eid not in outcome or not c.get("candidates"):
            continue
        top = c["candidates"][0]
        action, chosen = outcome[eid]
        agreed = (action == "assign" and chosen == top["ref"])
        b = f"{int(top['score'] * 10) / 10:.1f}"
        buckets.setdefault(b, {"n": 0, "agreed": 0})
        buckets[b]["n"] += 1
        buckets[b]["agreed"] += 1 if agreed else 0
        samples += 1

    rows = []
    for b in sorted(buckets):
        d = buckets[b]
        rows.append({"score_bucket": f"{b}~", "samples": d["n"],
                     "top_candidate_accepted": d["agreed"],
                     "rate": round(d["agreed"] / d["n"], 3)})
    qualifying = [r for r in rows if r["samples"] >= 5 and r["rate"] >= 0.95]
    rec = min((float(r["score_bucket"][:-1]) for r in qualifying), default=None)
    return {
        "samples": samples, "buckets": rows,
        "current_auto_link_threshold": cfg["auto_link_threshold"],
        "recommended_auto_link_threshold": rec,
        "verdict": ("근거 부족. 자동 연결을 켜지 마세요." if rec is None else
                    f"1위 후보 채택률 95% 이상 구간의 하한은 {rec}입니다."),
        "note": "표본이 충분히 쌓이기 전에는 auto_link_threshold를 낮추지 않습니다 (PRD D1).",
    }


def build_parser():
    p = argparse.ArgumentParser(prog="idea_check", description="Clio 운영 안정성")
    sub = p.add_subparsers(dest="cmd")
    n = sub.add_parser("init", help="데이터 디렉터리와 스키마 생성 (멱등)")
    n.set_defaults(fn=cmd_init)
    i = sub.add_parser("integrity", help="무결성 검사 (PRD §9.4)")
    i.add_argument("--strict", action="store_true", help="문제가 있으면 종료 코드 1")
    i.set_defaults(fn=cmd_integrity)
    b = sub.add_parser("backup", help="백업 생성 (PRD §9.3)")
    b.add_argument("--out")
    b.add_argument("--no-mirror", action="store_true")
    b.set_defaults(fn=cmd_backup)
    r = sub.add_parser("restore-test", help="백업 복구 시험 (TC7)")
    r.add_argument("--source", required=True)
    r.set_defaults(fn=cmd_restore_test)
    c = sub.add_parser("reconcile", help="채널 이력 대조용 보고")
    c.add_argument("--since")
    c.set_defaults(fn=cmd_reconcile)
    k = sub.add_parser("calibrate", help="D1 임계값 조정 근거")
    k.set_defaults(fn=cmd_calibrate)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
