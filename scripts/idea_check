#!/usr/bin/env python3
"""idea_check — 운영 안정성 계층 (PRD §9.3, §9.4, §10)."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import sqlite3
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from clio_core import (  # noqa: E402
    CLIO_VERSION, DB_NAME, ClioError, connect, data_dir, ensure_marker, invalidate_resolution,
    pointer_path, read_marker, read_pointer, resolution, resolve_root, run_cli, write_pointer,
)
from clio_ops import (  # noqa: E402
    COUNT_TABLES, counts, create_backup, fingerprint, mirror_backup, open_db, prune,
    read_registry_entry, registry_path, restore_copy, run_integrity, verify_backup,
)


def _open(path) -> sqlite3.Connection:
    """검사·대조용 읽기 연결. run_integrity는 Row 팩토리를 전제한다."""
    return open_db(path)


# --------------------------------------------------------------------------
# 데이터 위치 (v1.3.0)
# --------------------------------------------------------------------------

def _describe(st: dict) -> dict:
    m = st["marker"] or {}
    return {"path": st["path"], "exists": st["exists"], "db": st["db"],
            "marker_state": m.get("state"), "root_id": m.get("root_id"),
            "moved_to": m.get("moved_to"), "live": st["live"]}


def where_report() -> dict:
    """정본 위치와 그 근거, 충돌 진단. 아무것도 쓰지 않는다."""
    from clio_core import default_root, legacy_root, root_state
    res = resolve_root()
    noenv = resolve_root(use_env=False) if res["env"] else res
    reg = read_registry_entry(registry_path())
    if reg.get("operational_root"):
        reg["agrees"] = Path(reg["operational_root"]) == res["path"]
    return {
        "data_dir": str(res["path"]), "source": res["source"],
        "source_label": res["source_label"], "usable": res["problem"] is None,
        "problem": res["problem"], "warnings": res["warnings"],
        "followed_from": res["followed"], "state": _describe(res["state"]),
        "env": res["env"],
        "without_env": None if not res["env"] else {
            "data_dir": str(noenv["path"]), "source": noenv["source"],
            "problem": noenv["problem"]},
        "pointer": {"path": str(pointer_path()), "content": res["pointer"]},
        "candidates": {"legacy": _describe(root_state(legacy_root())),
                       "default": _describe(root_state(default_root()))},
        "registry": {"path": str(registry_path()), **reg},
        "clio_version": CLIO_VERSION,
    }


def cmd_where(args, cfg):
    rep = where_report()
    if args.strict and not rep["usable"]:
        p = rep["problem"]
        raise ClioError(p["code"], p["message"], data_dir=rep["data_dir"])
    return rep


# --------------------------------------------------------------------------
# 초기화
# --------------------------------------------------------------------------

def cmd_init(args, cfg):
    """데이터베이스와 디렉터리를 만든다. 이미 있으면 그대로 둔다 (멱등).

    --pin: 기존 설치(legacy)나 새 기본 위치(default)로 판정됐고 위치 기록이 없으면
    지금 위치를 기록해 둔다. 이후 기본값이 바뀌어도 정본이 흔들리지 않는다.
    """
    res = resolution()
    root = data_dir()
    if args.expect_root and Path(args.expect_root).expanduser() != root:
        raise ClioError("root_changed",
                        f"설치가 판정한 위치({args.expect_root})와 지금 위치({root})가 다릅니다.")
    existed = (root / DB_NAME).exists()
    conn = connect(create=True)
    marker = ensure_marker(root, "init:legacy" if existed else "init:new")
    for sub in ("attachments", "exports"):
        (root / sub).mkdir(parents=True, exist_ok=True)
    pinned = None
    if args.pin and res["source"] in ("legacy", "default") and read_pointer() is None:
        reason = "install:legacy" if res["source"] == "legacy" else (
            "install:existing" if existed else "install:new")
        write_pointer(root, marker["root_id"], reason)
        invalidate_resolution()
        pinned = {"path": str(pointer_path()), "reason": reason}
    version = conn.execute("SELECT value FROM meta WHERE key='schema_version'").fetchone()
    return {"data_dir": str(root), "source": res["source"],
            "source_label": res["source_label"], "created": not existed,
            "root_id": marker["root_id"], "pinned": pinned,
            "warnings": res["warnings"], "clio_version": CLIO_VERSION,
            "schema_version": version["value"] if version else None, "counts": counts(conn),
            "message": ("데이터베이스를 새로 만들었습니다." if not existed
                        else "기존 데이터베이스를 그대로 사용합니다.")}


def cmd_integrity(args, cfg):
    conn = connect(create=False)
    result = run_integrity(conn, data_dir())
    result["data_dir"] = str(data_dir())
    if not result["healthy"] and args.strict:
        raise ClioError("integrity_failed", f"무결성 문제 {result['problem_count']}건",
                        problems=result["problems"])
    return result


# --------------------------------------------------------------------------
# 백업 (PRD §9.3)
# --------------------------------------------------------------------------

def cmd_backup(args, cfg):
    conn = connect(create=False)
    root = data_dir()
    backup_root = Path(args.out or cfg["backup_root"]).expanduser()
    marker = read_marker(root) or {}
    bk = create_backup(conn, root, backup_root, cfg, kind="routine",
                       root_id=marker.get("root_id"))
    removed = prune(backup_root, cfg)
    mirror = ({"status": "disabled", "mirrored_to": None} if args.no_mirror
              else mirror_backup(Path(bk["path"]), backup_root, cfg.get("backup_mirror")))
    return {**bk, "backup_root": str(backup_root), "pruned": removed,
            "mirrored_to": mirror["mirrored_to"], "mirror": mirror}


def cmd_restore_test(args, cfg):
    """백업을 격리된 사본으로 복원해 검증한다 (TC7).

    1) 검증 목록의 모든 파일 해시 대조  2) 사본 복원(DB·첨부)  3) 무결성(첨부 포함)
    4) 백업 당시 지문 대조  5) 운영 DB와 건수 대조(참고용)
    운영 데이터에는 아무것도 쓰지 않는다.
    """
    src = Path(args.source).expanduser()
    bdir = src if src.is_dir() else src.parent
    db = bdir / DB_NAME if src.is_dir() else src
    if not db.exists():
        raise ClioError("backup_missing", f"백업 데이터베이스가 없습니다: {db}")
    files = verify_backup(bdir)
    try:
        manifest = json.loads((bdir / "manifest.json").read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        manifest = {}

    keep = Path(args.restore_to).expanduser() if args.restore_to else None
    if keep and keep.exists() and any(keep.iterdir()):
        raise ClioError("restore_target_not_empty", f"복원 위치가 비어 있지 않습니다: {keep}")
    out = keep or Path(tempfile.mkdtemp(prefix="clio-restore-"))
    try:
        restore_copy(bdir, db, out)
        restored = _open(out / DB_NAME)
        r_counts = counts(restored)
        integ = run_integrity(restored, out)
        fp = fingerprint(restored)
        restored.close()
    finally:
        if not keep:
            shutil.rmtree(out, ignore_errors=True)
    fp_match = (fp["sha256"] == manifest["fingerprint"]["sha256"]
                if manifest.get("fingerprint") else None)

    live_counts, diff = None, {}
    try:
        live = connect(create=False)
        live_counts = counts(live)
        diff = {t: {"live": live_counts[t], "restored": r_counts[t]}
                for t in COUNT_TABLES if live_counts[t] != r_counts[t]}
    except ClioError:
        pass
    verified = (integ["healthy"] and files["verified"] is not False and fp_match is not False)
    return {"source": str(db), "verified": verified,
            "manifest_verified": files["verified"], "files_checked": files["files_checked"],
            "file_problems": files["problems"], "fingerprint_match": fp_match,
            "restored_healthy": integ["healthy"], "restored_problems": integ["problems"],
            "restored_counts": r_counts, "restored_to": str(keep) if keep else None,
            "match": not diff, "diff": diff, "live_counts": live_counts,
            "note": "운영 DB와의 차이는 백업 이후 추가된 기록일 수 있습니다."}


# --------------------------------------------------------------------------
# reconcile / calibrate
# --------------------------------------------------------------------------

def cmd_reconcile(args, cfg):
    """DB 쪽에서 확인 가능한 사실만 보고한다.

    브리지가 제3자 도구이므로 채널 원본 이력을 이 도구가 직접 읽을 수 없다.
    따라서 '지시어를 보냈는데 저장되지 않은 메시지'는 여기서 알 수 없다.
    교수님이 Discord 이력과 대조할 수 있도록 DB가 아는 범위를 그대로 낸다.
    """
    conn = connect(create=False)
    since = args.since or "0000-00-00"
    rows = list(conn.execute(
        "SELECT e.id, e.captured_at, e.assign_state, s.message_id, i.ref "
        "FROM raw_entry e LEFT JOIN source s ON s.id=e.source_id "
        "LEFT JOIN idea i ON i.id=e.idea_id "
        "WHERE substr(e.captured_at,1,10) >= ? ORDER BY e.captured_at", (since,)))
    no_msg_id = sum(1 for r in rows if not r["message_id"])
    return {
        "since": since, "captured": len(rows),
        "unassigned": sum(1 for r in rows if r["assign_state"] == "unassigned"),
        "without_message_id": no_msg_id,
        "entries": [{"entry_id": r["id"], "captured_at": r["captured_at"],
                     "message_id": r["message_id"], "ref": r["ref"]} for r in rows],
        "limitation": "브리지가 제3자 도구이므로 채널 원본 이력은 이 도구가 읽을 수 없습니다. "
                      "위 목록을 Discord 채널의 '글감:' 메시지와 직접 대조하세요.",
    }


def cmd_calibrate(args, cfg):
    """D1 임계값 조정 근거 산출 (PRD §14.1).

    similar이 남긴 후보 제시 이력과, 그 뒤 실제로 어떤 글감에 배정됐는지를 대조한다.
    """
    conn = connect(create=False)
    cands = [json.loads(r["payload"]) for r in conn.execute(
        "SELECT payload FROM action_log WHERE action='candidates' ORDER BY id")]
    outcome = {}
    for r in conn.execute(
        "SELECT action, payload FROM action_log WHERE action IN ('assign','new_idea') "
        "AND undone_at IS NULL ORDER BY id"):
        p = json.loads(r["payload"])
        if p.get("entry_id"):
            outcome[p["entry_id"]] = (r["action"], p.get("idea_ref") or p.get("ref"))

    buckets, samples = {}, 0
    for c in cands:
        eid = c.get("entry_id")
        if not eid or eid not in outcome or not c.get("candidates"):
            continue
        top = c["candidates"][0]
        action, chosen = outcome[eid]
        agreed = (action == "assign" and chosen == top["ref"])
        b = f"{int(top['score'] * 10) / 10:.1f}"
        buckets.setdefault(b, {"n": 0, "agreed": 0})
        buckets[b]["n"] += 1
        buckets[b]["agreed"] += 1 if agreed else 0
        samples += 1

    rows = []
    for b in sorted(buckets):
        d = buckets[b]
        rows.append({"score_bucket": f"{b}~", "samples": d["n"],
                     "top_candidate_accepted": d["agreed"],
                     "rate": round(d["agreed"] / d["n"], 3)})
    qualifying = [r for r in rows if r["samples"] >= 5 and r["rate"] >= 0.95]
    rec = min((float(r["score_bucket"][:-1]) for r in qualifying), default=None)
    return {
        "samples": samples, "buckets": rows,
        "current_auto_link_threshold": cfg["auto_link_threshold"],
        "recommended_auto_link_threshold": rec,
        "verdict": ("근거 부족. 자동 연결을 켜지 마세요." if rec is None else
                    f"1위 후보 채택률 95% 이상 구간의 하한은 {rec}입니다."),
        "note": "표본이 충분히 쌓이기 전에는 auto_link_threshold를 낮추지 않습니다 (PRD D1).",
    }


def build_parser():
    p = argparse.ArgumentParser(prog="idea_check", description="Clio 운영 안정성")
    sub = p.add_subparsers(dest="cmd")
    w = sub.add_parser("where", help="정본 데이터 위치와 판정 근거 (쓰기 없음)")
    w.add_argument("--strict", action="store_true", help="쓸 수 없는 상태면 종료 코드 1")
    w.set_defaults(fn=cmd_where)
    n = sub.add_parser("init", help="데이터 디렉터리와 스키마 생성 (멱등)")
    n.add_argument("--pin", action="store_true", help="판정된 위치를 위치 기록 파일에 고정")
    n.add_argument("--expect-root", help="이 위치가 아니면 아무것도 만들지 않고 실패")
    n.set_defaults(fn=cmd_init)
    i = sub.add_parser("integrity", help="무결성 검사 (PRD §9.4)")
    i.add_argument("--strict", action="store_true", help="문제가 있으면 종료 코드 1")
    i.set_defaults(fn=cmd_integrity)
    b = sub.add_parser("backup", help="백업 생성 + 검증 (PRD §9.3)")
    b.add_argument("--out", help="백업 루트 (기본: config의 backup_root)")
    b.add_argument("--no-mirror", action="store_true")
    b.set_defaults(fn=cmd_backup)
    r = sub.add_parser("restore-test", help="백업 복원 시험 (TC7)")
    r.add_argument("--source", required=True)
    r.add_argument("--restore-to", help="격리 사본을 남길 빈 폴더 (기본: 임시 폴더 후 삭제)")
    r.set_defaults(fn=cmd_restore_test)
    c = sub.add_parser("reconcile", help="채널 이력 대조용 보고")
    c.add_argument("--since")
    c.set_defaults(fn=cmd_reconcile)
    k = sub.add_parser("calibrate", help="D1 임계값 조정 근거")
    k.set_defaults(fn=cmd_calibrate)
    return p


if __name__ == "__main__":
    run_cli(build_parser, lambda args, cfg: args.fn(args, cfg))
